<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Version: <%= Time.now.to_i %> -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Monitor Dashboard</title>
    <% begin; asset_v = File.mtime(File.expand_path('../public/script.js', __dir__)).to_i; css_v = File.mtime(File.expand_path('../public/styles.css', __dir__)).to_i; rescue; asset_v = css_v = Time.now.to_i; end %>
    <link rel="stylesheet" href="<%= request.script_name %>/styles.css?v=<%= css_v %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <script>
        // Base path for the app when mounted under a sub-URL in OOD
        window.APP_BASE_PATH = "<%= request.script_name %>";
    </script>
    
    <!-- Navigation Bar -->
    <nav class="top-nav">
        <a href="/pun/sys/dashboard" class="nav-link">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <span class="nav-separator"><i class="fas fa-chevron-right"></i></span>
        <span class="nav-current"><i class="fas fa-briefcase"></i> Job Monitor</span>
    </nav>
    
    <div class="container">
        <!-- Header -->
        <header class="header">
            <h1><i class="fas fa-briefcase"></i> Job Monitor</h1>
            <div class="header-controls">
                <div class="last-update">
                    Last updated: <span id="last-update-time">Never</span>
                </div>
                <button id="refresh-btn" class="btn btn-primary">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
                <label class="switch">
                    <input type="checkbox" id="auto-refresh-toggle" checked>
                    <span class="slider"></span>
                </label>
                <span class="auto-refresh-label">Auto-refresh (30s)</span>
            </div>
        </header>

        <!-- Loading Overlay -->
        <div id="loading-overlay" class="loading-overlay">
            <div class="spinner"></div>
        </div>

        <!-- Toast Notification Container -->
        <div id="toast-container" class="toast-container"></div>

        <!-- Error Message -->
        <div id="error-message" class="error-message hidden">
            <i class="fas fa-exclamation-triangle"></i>
            <span id="error-text"></span>
        </div>

        <!-- Job Stats Overview -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background: #3498db;">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Total Jobs</div>
                    <div class="stat-value" id="stat-total-jobs">-</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: #2ecc71;">
                    <i class="fas fa-play-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Running Jobs</div>
                    <div class="stat-value" id="stat-running-jobs">-</div>
                    <div class="stat-subtext" id="stat-cpus-used">- CPUs used</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: #f39c12;">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Pending Jobs</div>
                    <div class="stat-value" id="stat-pending-jobs">-</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon" style="background: #9b59b6;">
                    <i class="fas fa-microchip"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">GPUs in Use</div>
                    <div class="stat-value" id="stat-gpus-used">-</div>
                </div>
            </div>
        </section>

        <!-- Current Jobs Section -->
        <section class="section">
            <h2><i class="fas fa-clock"></i> Current Jobs (Running & Pending)</h2>
            <div class="table-controls">
                <input type="text" id="current-job-search" class="search-input" placeholder="Search current jobs...">
                <select id="current-job-filter" class="filter-select">
                    <option value="all">All Jobs</option>
                    <option value="R">Running Only</option>
                    <option value="PD">Pending Only</option>
                </select>
            </div>
            <div class="table-wrapper">
                <table class="jobs-table" id="current-jobs-table">
                    <thead>
                        <tr>
                            <th data-sort="job_id">Job ID <i class="fas fa-sort"></i></th>
                            <th data-sort="name">Name <i class="fas fa-sort"></i></th>
                            <th data-sort="partition" class="tooltip-header" data-tooltip="The SLURM partition/queue where the job runs" title="The SLURM partition/queue where the job runs">Partition <i class="fas fa-sort"></i></th>
                            <th data-sort="state">State <i class="fas fa-sort"></i></th>
                            <th data-sort="time_used" class="tooltip-header" data-tooltip="Elapsed time since job started running" title="Elapsed time since job started running">Time Used <i class="fas fa-sort"></i></th>
                            <th data-sort="time_limit" class="tooltip-header" data-tooltip="Maximum runtime allowed for the job" title="Maximum runtime allowed for the job">Time Limit <i class="fas fa-sort"></i></th>
                            <th data-sort="nodes" class="tooltip-header" data-tooltip="Number of compute nodes allocated" title="Number of compute nodes allocated">Nodes <i class="fas fa-sort"></i></th>
                            <th data-sort="cpus" class="tooltip-header" data-tooltip="Number of CPU cores allocated" title="Number of CPU cores allocated">CPUs <i class="fas fa-sort"></i></th>
                            <th data-sort="gpus" class="tooltip-header" data-tooltip="Number of GPUs allocated" title="Number of GPUs allocated">GPUs <i class="fas fa-sort"></i></th>
                            <th class="tooltip-header" data-tooltip="Specific nodes assigned to the job" title="Specific nodes assigned to the job">Node List</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="current-jobs-table-body">
                        <!-- Current job rows will be inserted here -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Job History Section -->
        <section class="section">
            <h2><i class="fas fa-history"></i> Job History</h2>
            <div class="table-controls">
                <input type="text" id="history-job-search" class="search-input" placeholder="Search job history...">
                <select id="history-days" class="filter-select">
                    <option value="1">Last 24 Hours</option>
                    <option value="7" selected>Last 7 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="custom">Custom Range</option>
                </select>
                <div id="custom-date-range" class="custom-date-range" style="display: none;">
                    <input type="datetime-local" id="history-start-date" class="date-input">
                    <span>to</span>
                    <input type="datetime-local" id="history-end-date" class="date-input">
                    <button id="apply-custom-range" class="apply-btn">Apply</button>
                </div>
                <select id="history-state-filter" class="filter-select">
                    <option value="all">All States</option>
                    <option value="COMPLETED">Completed</option>
                    <option value="FAILED">Failed</option>
                    <option value="CANCELLED">Cancelled</option>
                    <option value="TIMEOUT">Timeout</option>
                </select>
            </div>
            <div class="table-wrapper">
                <table class="jobs-table" id="history-jobs-table">
                    <thead>
                        <tr>
                            <th data-sort="job_id">Job ID <i class="fas fa-sort"></i></th>
                            <th data-sort="name">Name <i class="fas fa-sort"></i></th>
                            <th data-sort="partition" class="tooltip-header" data-tooltip="The SLURM partition/queue where the job ran" title="The SLURM partition/queue where the job ran">Partition <i class="fas fa-sort"></i></th>
                            <th data-sort="state">State <i class="fas fa-sort"></i></th>
                            <th data-sort="elapsed" class="tooltip-header" data-tooltip="Total time the job ran" title="Total time the job ran">Elapsed <i class="fas fa-sort"></i></th>
                            <th data-sort="start">Start Time <i class="fas fa-sort"></i></th>
                            <th data-sort="end">End Time <i class="fas fa-sort"></i></th>
                            <th data-sort="max_rss" class="tooltip-header" data-tooltip="Maximum memory used during job execution (RSS - Resident Set Size)" title="Maximum memory used during job execution (RSS - Resident Set Size)">Max Memory <i class="fas fa-sort"></i></th>
                            <th data-sort="nodes" class="tooltip-header" data-tooltip="Number of compute nodes used" title="Number of compute nodes used">Nodes <i class="fas fa-sort"></i></th>
                            <th data-sort="cpus" class="tooltip-header" data-tooltip="Number of CPU cores used" title="Number of CPU cores used">CPUs <i class="fas fa-sort"></i></th>
                            <th data-sort="gpus" class="tooltip-header" data-tooltip="Number of GPUs used" title="Number of GPUs used">GPUs <i class="fas fa-sort"></i></th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="history-jobs-table-body">
                        <!-- Historical job rows will be inserted here -->
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Job Details Modal -->
    <div id="job-details-modal" class="modal hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-info-circle"></i> Job Details</h2>
                <button class="modal-close" onclick="closeJobDetailsModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="tabs">
                    <button class="tab-button active" data-tab="basic">Basic Information</button>
                    <button class="tab-button" data-tab="resources">Resources & I/O</button>
                    <button class="tab-button" data-tab="script">Job Script</button>
                </div>
                <div id="job-details-content" class="modal-details">
                    <!-- Job details will be inserted here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Toast notification -->
    <div id="toast-notification" class="toast" style="display: none;">
        <span class="toast-message"></span>
        <button class="toast-close" aria-label="Dismiss">&times;</button>
    </div>

    <script src="<%= request.script_name %>/script.js?v=<%= asset_v %>"></script>
</body>
</html>

